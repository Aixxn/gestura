{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/",
    "module": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["./*"]
    }
  },
  "include": ["app.ts", "bin/**/*.ts", "routes/**/*.ts", "middleware/**/*.ts", "types/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}
